{
	"window.zoomLevel": -1,
	"window.commandCenter": true,
	"window.titleBarStyle": "custom",
	"window.newWindowDimensions": "inherit", // new

	"debug.console.fontFamily": "SF Mono",
	"debug.console.fontSize": 17,
	"debug.console.lineHeight": 21,

	"editor.tabSize": 3,
	"editor.fontSize": 16,
	"editor.lineHeight": 36,
	"editor.padding.top": 20,
	"editor.padding.bottom": 20,
	"editor.formatOnSave": true,
	"editor.linkedEditing": true,
	"editor.smoothScrolling": true,
	"editor.suggestLineHeight": 35,
	"editor.inlayHints.fontSize": 12,
	"editor.renderWhitespace": "all",
	"editor.inlayHints.padding": true,
	"editor.suggestSelection": "first",
	"editor.inlineSuggest.enabled": true,
	"editor.stickyScroll.enabled": false,
	"editor.suggest.showSnippets": false,
	"editor.accessibilitySupport": "off",
	"editor.guides.bracketPairs": "active",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.copyWithSyntaxHighlighting": false, // new
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.suggest.snippetsPreventQuickSuggestions": true,
	"editor.wordSeparators": "`~!@#$%^&*-()=+[{]}\\|;:'\",.<>/?",
	"editor.fontVariations": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'zero'",
	"editor.fontLigatures": "'ss01','ss02','ss03', 'cv01','cv02','cv10','cv03','cv06','cv09'",
	"editor.fontFamily": "\"SFMono-Regular\",\"CommitMono\",MonoLisa,\"BerkeleyMono Nerd Font\",\"Rec Mono Linear\",\"IBM Plex\"",

	"workbench.editor.empty.hint": "hidden",
	"workbench.editor.enablePreview": false,
	"workbench.tree.renderIndentGuides": "always",

	"prettier.semi": false,
	"prettier.printWidth": 80,
	"prettier.singleQuote": true,
	"prettier.useTabs": true,

	"terminal.integrated.defaultProfile.osx": "zsh",
	"terminal.explorerKind": "external",
	"terminal.external.osxExec": "iTerm.app",
	"terminal.integrated.fontFamily": "CommitMono",
	"terminal.integrated.lineHeight": 1,
	"terminal.integrated.fontSize": 18,

	"explorer.compactFolders": false,

	"emmet.triggerExpansionOnTab": true,
	"emmet.showExpandedAbbreviation": "inMarkupAndStylesheetFilesOnly",
	"emmet.includeLanguages": {
		"javascript": "javascriptreact",
		"typescript": "typescriptreact",
		"postcss": "css"
	},

	"[markdown]": { "editor.wordWrapColumn": 50 },
	"[css]": { "editor.suggest.showVariables": true },
	"[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.snippetSuggestions": "bottom"
	},

	"files.autoSaveDelay": 1500,
	"files.associations": { "*.jsx": "javascriptreact" },
	"editor.guides.indentation": true,
	"editor.matchBrackets": "never", // new
	"editor.colorDecorators": false, // new
	"editor.overviewRulerBorder": false, // new
	"editor.renderLineHighlight": "all", // new
	"editor.cursorBlinking": "phase", // new
	"workbench.tips.enabled": false, // new
	"security.workspace.trust.enabled": false,

	"http.systemCertificates": false,
	"markdown-preview-enhanced.previewTheme": "solarized-dark.css",
	"git.mergeEditor": false,

	"totalTypeScript.hideAllTips": true,
	"totalTypeScript.hideBasicTips": true,

	"typescript.tsserver.log": "off",
	"typescript.updateImportsOnFileMove.enabled": "always",
	"typescript.inlayHints.parameterNames.enabled": "all",
	"javascript.inlayHints.parameterNames.enabled": "all",
	"javascript.inlayHints.enumMemberValues.enabled": true,
	"javascript.updateImportsOnFileMove.enabled": "never",

	"gitlens.views.showRelativeDateMarkers": false,

	"supermaven.enable": {
		"*": false
	},
	"supermaven.enableFixWithSupermaven": true,
	"diffEditor.renderSideBySide": true,
	"diffEditor.ignoreTrimWhitespace": false,
	"githubPullRequests.pullBranch": "never",
	"vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",

	"evenbettercomments.enabled": true,
	"update.mode": "manual",
	"window.density.editorTabHeight": "default",
	"editor.minimap.enabled": false,
	"redhat.telemetry.enabled": true,
	"gitlens.views.scm.grouped.views": {
		"commits": false,
		"branches": true,
		"remotes": true,
		"stashes": false,
		"tags": true,
		"worktrees": true,
		"contributors": true,
		"repositories": false,
		"searchAndCompare": false,
		"launchpad": false
	},

	"vscode_custom_css.imports": [
		"file:///Users/omkar/vscode_setup_insiders/custom-vscode-script.js",
		"file:///Users/omkar/vscode_setup_insiders/custom-vscode-styles.css"
	],

	"friendly-ui.customCssPath": "/Users/omkar/vscode_setup_insiders/friendly-ui/custom.css",
	"friendly-ui.customJsPath": "/Users/omkar/vscode_setup_insiders/friendly-ui/custom.js",
	"friendly-ui.disableWorkbenchJs": true,

	// Migrated from vscode insiders
	"workbench.colorTheme": "Ivalo",
	"editor.minimap.renderCharacters": false,
	// "workbench.fontAliasing": "antialiased",
	"workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-dark",
	"workbench.tree.indent": 17,
	"breadcrumbs.symbolPath": "off",
	"workbench.activityBar.location": "top",
	"zenMode.hideLineNumbers": false,
	"search.showLineNumbers": true,
	"terminal.integrated.tabs.location": "left",
	"typescript.preferences.includePackageJsonAutoImports": "on",
	"typescript.preferences.preferTypeOnlyAutoImports": true,
	"editor.snippetSuggestions": "bottom",
	"editor.suggest.preview": true,
	"editor.hover.delay": 1000,
	"editor.trimAutoWhitespace": false,
	"javascript.suggest.completeFunctionCalls": true,
	"problems.decorations.enabled": false,
	"workbench.list.smoothScrolling": true,
	"terminal.integrated.smoothScrolling": true,
	"editor.colorDecoratorsActivatedOn": "click",
	"workbench.colorCustomizations": {
		"activityBarBadge.foreground": "#ffffffbf",
		"activityBarBadge.background": "#3c3c3ca3",
		"editor.background": "#1c1c1c",
		"editor.lineHighlightBackground": "#26282d",
		"editor.lineHighlightBorder": "#00000000",
		"editorBracketMatch.background": "#43454a",
		"editorBracketMatch.border": "#00000000",
		"editorGroupHeader.tabsBackground": "#2B2D30",
		"editorGutter.background": "#00000000",
		"editorStickyScroll.border": "#393939",
		"editorStickyScroll.shadow": "#00000078",
		"editorWidget.background": "#2B2D30",
		"focusBorder": "#00000000",
		"panel.background": "#2B2D30",
		"scrollbar.shadow": "#00000072",
		"scrollbarSlider.background": "#ffffff12",
		"sideBar.background": "#2B2D30",
		"sideBarSectionHeader.border": "#00000000",
		"sideBarSectionHeader.background": "#3d3e42",
		"statusBar.background": "#2B2D30",
		"statusBar.debuggingBackground": "#2B2D30",
		"statusBar.foreground": "#757575",
		"panel.border": "#00000000",
		"sideBar.border": "#00000000",
		"statusBar.noFolderBackground": "#2B2D30",
		"gitDecoration.modifiedResourceForeground": "#74aeec",
		"gitDecoration.stageModifiedResourceForeground": "#74aeec",
		"gitDecoration.addedResourceForeground": "#7fd27fd9",
		"gitDecoration.renamedResourceForeground": "#74aeec",
		"gitDecoration.untrackedResourceForeground": "#f7aeae",
		"gitDecoration.ignoredResourceForeground": "#ffffff3b",
		"statusBarItem.remoteBackground": "#2B2D30",
		"statusBarItem.remoteForeground": "#757575",
		"tab.activeBorderTop": "#00000000",
		"tab.activeBorder": "#00000000",
		"tab.border": "#2B2D30",
		"tab.inactiveBackground": "#2B2D30",
		"terminal.background": "#1E1F22",
		"terminal.border": "#2B2D30",
		"titleBar.activeBackground": "#2B2D30",
		"titleBar.inactiveBackground": "#2B2D30",
		"quickInput.background": "#2B2D30",
		"input.background": "#3d3e42",
		"button.background": "#3d3e42"
	}
}
